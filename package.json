{
  "name": "my-shioaji-watch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --open /?demo=1",
    "build": "tsc --noEmit && vite build",
    "deploy": "tsc --noEmit && vite build && curl -sS -X POST http://127.0.0.1:8080/api/v1/apps/mywatch -F files=@dist/index.html",
    "undeploy": "curl -sS -X DELETE http://127.0.0.1:8080/api/v1/apps/mywatch",
    "phone": "node phone-server.mjs"
  },
  "dependencies": {
    "lightweight-charts": "5.0.8"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
